{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ScamShield: server",
      "type": "debugpy",
      "request": "launch",
      "module": "src.server",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PORT": "8000",
        "SCAMSHIELD_BUILD_ID": "local-debug"
      }
    },
    {
      "name": "ScamShield: all Python tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-p", "test_*.py", "-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ScamShield: reproduce evaluation",
      "type": "debugpy",
      "request": "launch",
      "module": "src.evaluate",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
