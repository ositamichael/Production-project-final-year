SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://localhost:5432/unicircle
DATABASE_USERNAME=unicircle
DATABASE_PASSWORD=change-me
OIDC_CLIENT_ID=provided-by-university-it
OIDC_CLIENT_SECRET=provided-by-university-it
OIDC_ISSUER_URI=https://identity-provider.example/.well-known/openid-configuration
OPENAI_API_KEY=replace-with-a-server-side-project-key
UNICIRCLE_ASSISTANT_MODEL=gpt-6.1-sol
UNICIRCLE_ASSISTANT_IMAGE_MODEL=gpt-image-2.5-flare
UNICIRCLE_STUN_URLS=stun:stun.l.google.com:19302
# Obtain real TURN endpoints from your relay provider. See docs/calling-across-networks.md.
# Example transports: turn:relay.example:3478?transport=udp,turns:relay.example:5349?transport=tcp
UNICIRCLE_TURN_URLS=
# Choose ONE authentication method: provider username/credential OR coturn shared secret.
UNICIRCLE_TURN_USERNAME=
UNICIRCLE_TURN_CREDENTIAL=
UNICIRCLE_TURN_SHARED_SECRET=
UNICIRCLE_TURN_CREDENTIAL_TTL_SECONDS=21600
# all = direct with relay fallback; relay = force TURN for acceptance testing/privacy.
UNICIRCLE_CALL_ICE_TRANSPORT_POLICY=all
# Free-plan Xirsys API option: leave ALL manual TURN settings above empty.
# Choose the free Developer plan, no paid upgrade. Calls needing relay stop at its hard cap.
# Account creation/terms and dashboard credentials are required; never commit real secrets.
UNICIRCLE_XIRSYS_IDENT=
UNICIRCLE_XIRSYS_SECRET=
UNICIRCLE_XIRSYS_CHANNEL=
